{
  "name": "stormroute-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/build-server.mjs --production",
    "build:vercel": "node scripts/prepare-assets.mjs && next build",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "node ../dist/node/server.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.8.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
